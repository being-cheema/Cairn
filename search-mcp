#!/bin/sh
# The MCP server is cairn-mcp, inside Cairn.app. This stays so that an agent
# already set up with `claude mcp add search -- …/search-mcp` goes on working.
# It runs the one built in this checkout of Cairn, or the installed app's.
# `exec` keeps the process, so Cairn still sees the agent as what started it.
here=$(cd "$(dirname "$0")" && pwd)
for tool in "$here/build/Cairn.app/Contents/MacOS/cairn-mcp" "/Applications/Cairn.app/Contents/MacOS/cairn-mcp"; do
  [ -x "$tool" ] && exec "$tool" "$@"
done
echo "search-mcp: no cairn-mcp yet. Build Cairn first: ./build.sh" >&2
exit 1
